# The launcher copies the brew-verified signal-desktop .deb from the
# Caskroom into the build context before building.
FROM docker.io/library/debian:trixie-slim

COPY cask.deb /tmp/cask.deb
RUN apt-get update \
    && apt-get install -y --no-install-recommends /tmp/cask.deb fonts-dejavu libgl1-mesa-dri \
    && rm /tmp/cask.deb \
    && rm -rf /var/lib/apt/lists/*

# The container is the sandbox; Chromium's own sandbox cannot nest inside
# a rootless userns, hence --no-sandbox.
# --ozone-platform-hint=auto proved unreliable in brave-oci, so choose
# the platform from the environment the launcher passes in: wayland when
# the socket env is present, x11 otherwise.
ENTRYPOINT ["/bin/sh", "-c", "p=x11; [ -n \"$WAYLAND_DISPLAY\" ] && p=wayland; exec /opt/Signal/signal-desktop --no-sandbox --ozone-platform=$p \"$@\"", "--"]
